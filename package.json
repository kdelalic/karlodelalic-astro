{
  "name": "karlodelalic.me",
  "private": true,
  "description": "A minimal personal homepage and recipe collection.",
  "version": "0.1.0",
  "author": "Karlo Delalic",
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/mynaui": "^1.2.19",
    "@iconify-json/twemoji": "^1.2.5",
    "astro": "^7.1.6",
    "astro-icon": "^1.1.5",
    "decap-cms-app": "^3.15.1",
    "fuse.js": "^7.5.0",
    "prismjs": "^1.30.0",
    "sass": "^1.102.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6"
  },
  "keywords": [
    "karlo delalic",
    "astro",
    "builder",
    "personal website"
  ],
  "license": "MIT",
  "scripts": {
    "build": "./build.sh && astro build",
    "dev": "./build.sh && astro dev",
    "generate:icons": "bun src/scripts/generate-icons.js",
    "generate:palettes": "bun scripts/generate-palettes.ts",
    "format": "prettier --write src/**/*.{js,jsx,tsx,astro,scss,md}",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint ."
  },
  "lint-staged": {
    "src/**/*.{js,jsx,scss}": [
      "prettier --write",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kdelalic/karlodelalic-astro"
  },
  "bugs": {
    "url": "https://github.com/kdelalic/karlodelalic-astro/issues"
  }
}
