---
import "../globals/_base.scss"
import "../components/layout.scss"
import { palettes } from "../data/palettes"

interface Props {
  title?: string
  description?: string
  keywords?: string[]
  centered?: boolean
  wide?: boolean
  date?: string
  hidePageTitle?: boolean
}

const {
  title = "Karlo Delalic",
  description = "Karlo Delalic is a builder. Find his small personal projects, recipes, and profiles.",
  keywords = ["karlo delalic", "builder", "personal projects"],
  centered = false,
  wide = false,
  date,
  hidePageTitle = false,
} = Astro.props

const siteUrl = "https://karlodelalic.me"
const canonicalPath = Astro.url.pathname
  .replace(/\/index\.html$/, "/")
  .replace(/\.html$/, "")
const canonicalURL = new URL(canonicalPath, siteUrl)
const socialImageURL = new URL("/og.png", siteUrl)

const paletteIds = palettes.map((palette) => palette.id)
const paletteCanvasColors = Object.fromEntries(
  palettes.map((palette) => [palette.id, palette.colors.canvas])
)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
      sizes="any"
      data-palette-favicon
    />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png"
      sizes="180x180"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(", ")} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta
      property="og:image:alt"
      content="A cozy campsite illustration beside the words Karlo Delalic, Builder."
    />
    <meta name="theme-color" content={palettes[0].colors.canvas} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:creator" content="@karlodelalic" />

    <script is:inline define:vars={{ paletteIds, paletteCanvasColors }}>
      ;(function () {
        const storageKey = "karlodelalic-palette"
        let previousPalette
        try {
          previousPalette = sessionStorage.getItem(storageKey)
        } catch {}

        const navigation = performance.getEntriesByType("navigation")[0]
        const isReload =
          (navigation && navigation.type === "reload") ||
          (performance.navigation && performance.navigation.type === 1)
        const hasValidPrevious = paletteIds.includes(previousPalette)
        let palette = hasValidPrevious && !isReload ? previousPalette : null

        if (!palette) {
          const choices = isReload && hasValidPrevious
            ? paletteIds.filter((id) => id !== previousPalette)
            : paletteIds
          palette = choices[Math.floor(Math.random() * choices.length)]
        }

        document.documentElement.dataset.palette = palette
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", paletteCanvasColors[palette])

        try {
          sessionStorage.setItem(storageKey, palette)
        } catch {}
      })()
    </script>
    <script>
      import { palettes } from "../data/palettes"
      import { applyPaletteFavicon } from "../scripts/palette-favicon"

      const palette = palettes.find(
        (entry) => entry.id === document.documentElement.dataset.palette
      )
      if (palette) applyPaletteFavicon(palette)
    </script>
  </head>
  <body>
    <div class:list={["site-frame", { "site-frame--wide": wide }]}>
      <slot name="header" />
    </div>
    <div
      class:list={[
        "content",
        { centered, "content--wide": wide },
      ]}
    >
      {!hidePageTitle && title && <h1 class="title">{title}</h1>}
      {date && <p class="date">{date}</p>}
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
