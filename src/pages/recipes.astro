---
import { getCollection } from "astro:content"
import BaseLayout from "../layouts/BaseLayout.astro"
import Header from "../components/Header.astro"
import RecipesClient from "../components/RecipesClient.astro"

const allRecipes = (await getCollection("recipes")).sort((first, second) =>
  first.data.title.localeCompare(second.data.title, "en", {
    sensitivity: "base",
  })
)

// Prepare recipes data
const recipesData = allRecipes.map((recipe) => {
  return {
    id: recipe.id,
    title: recipe.data.title,
    tags: recipe.data.tags || [],
    source: recipe.data.source,
    notes: recipe.data.notes,
    type: recipe.data.type,
    slug:
      recipe.data.type === "custom-recipe"
        ? `/custom-recipes/${recipe.id}`
        : null,
    image: recipe.data.image,
  }
})

const keywords = ["karlo delalic", "recipes", "personal recipe collection"]
---

<BaseLayout
  title="Recipes"
  description="Karlo Delalic's searchable personal recipe collection."
  keywords={keywords}
  wide={true}
>
  <Header slot="header" />
  <RecipesClient recipes={recipesData} />
</BaseLayout>
