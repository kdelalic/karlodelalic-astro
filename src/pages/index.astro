---
import BaseLayout from "../layouts/BaseLayout.astro"
import Header from "../components/Header.astro"
import "./_index.scss"

const apps = [
  {
    name: "Campground Checker",
    emoji: "🏕️",
    href: "https://campsite.karlodelalic.me",
  },
  {
    name: "Recipe Generator",
    emoji: "🪄",
    href: "https://recipe.karlodelalic.me",
  },
  {
    name: "TDEE Calculator",
    emoji: "⚖️",
    href: "https://tdee.karlodelalic.me",
  },
  { name: "Recipes", emoji: "🍲", href: "/recipes" },
]
---

<BaseLayout hidePageTitle={true}>
  <Header slot="header" />
  <div class="home">
    <h1 class="visually-hidden">Karlo Delalic</h1>
    <p class="home__intro">
      Builder. A small collection of things I make and use.
    </p>

    <section class="home__section" aria-labelledby="apps-heading">
      <h2 id="apps-heading">Apps</h2>
      <ul class="app-links">
        {
          apps.map((app) => (
            <li>
              <a href={app.href}>
                <span class="app-links__emoji" aria-hidden="true">
                  {app.emoji}
                </span>
                <span>{app.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="home__section" aria-labelledby="elsewhere-heading">
      <h2 id="elsewhere-heading">Elsewhere</h2>
      <ul class="profile-links">
        <li><a href="https://github.com/kdelalic">GitHub</a></li>
        <li>
          <a href="https://www.linkedin.com/in/karlodelalic/">LinkedIn</a>
        </li>
      </ul>
    </section>

    <section class="home__section" aria-labelledby="useful-heading">
      <h2 id="useful-heading">Useful</h2>
      <ul class="resource-links">
        <li>
          <a href="https://gist.github.com/n1snt/2cccc8aa5f7b645a7628d3512c70deb6">
            <span class="resource-links__emoji" aria-hidden="true">⌨️</span>
            <span>Fast, minimal Zsh setup by n1snt</span>
          </a>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
