---
import { Icon } from "astro-icon/components"
---

<div class="search-bar">
  <label class="visually-hidden" for="recipe-search">Search recipes</label>
  <Icon
    name="fa6-solid:magnifying-glass"
    class="search-icon"
    aria-hidden="true"
  />
  <input
    type="search"
    id="recipe-search"
    placeholder="Search recipes"
    autocomplete="off"
  />
  <button
    type="button"
    id="clear-search"
    class="clear-search"
    aria-label="Clear recipe search"
    hidden
  >
    <Icon name="fa6-solid:xmark" aria-hidden="true" />
  </button>
</div>

<script>
  const searchInput = document.querySelector<HTMLInputElement>("#recipe-search")
  const clearButton = document.querySelector<HTMLButtonElement>("#clear-search")

  const updateClearButton = () => {
    if (clearButton) clearButton.hidden = !searchInput?.value
  }

  const dispatchSearch = () => {
    window.dispatchEvent(
      new CustomEvent("recipeSearch", {
        detail: { value: searchInput?.value ?? "" },
      })
    )
  }

  updateClearButton()

  searchInput?.addEventListener("input", () => {
    updateClearButton()
    dispatchSearch()
  })

  clearButton?.addEventListener("click", () => {
    if (!searchInput) return
    searchInput.value = ""
    searchInput.focus()
    updateClearButton()
    dispatchSearch()
  })
</script>
