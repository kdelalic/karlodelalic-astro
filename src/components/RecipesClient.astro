---
import Recipe from "./Recipe.astro"
import Chip from "./Chip.astro"
import SearchBar from "./SearchBar.astro"
import ScrollToTop from "./ScrollToTop.astro"
import {
  groupRecipeTags,
  normalizeRecipeTags,
} from "../data/recipeTags"
import "../pages/_recipes.scss"

interface RecipeData {
  id: string
  image?: unknown
  notes?: string
  slug?: string | null
  source?: string
  tags: string[]
  title: string
  type: string
}

interface Props {
  recipes: RecipeData[]
}

const { recipes } = Astro.props

const normalizedRecipes = recipes.map((recipe) => ({
  ...recipe,
  tags: normalizeRecipeTags(recipe.tags),
}))

const allTags = [
  ...new Set(normalizedRecipes.flatMap((recipe) => recipe.tags)),
].sort()
const tagGroups = groupRecipeTags(allTags)
---

<div class="recipe-tools">
  <SearchBar />
  <a class="skip-link" href="#recipes-list">Skip to recipe results</a>
  <details class="filter-panel">
    <summary>
      <span class="filter-panel__label">Filter recipes</span>
      <span class="filter-panel__status" id="filter-status"></span>
    </summary>
    <div class="filter-groups" id="tag-chips">
      {
        tagGroups.map((group) => (
          <section class="filter-group" data-filter-group>
            <h2 class="filter-group__title">{group.label}</h2>
            <div class="chips">
              {group.tags.map((tag) => (
                <Chip label={tag} data-tag={tag} active={false} />
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </details>
  <p class="recipe-count" id="recipe-count" aria-live="polite">
    {normalizedRecipes.length} recipes
  </p>
</div>

<div class="recipes" id="recipes-list" tabindex="-1">
  {
    normalizedRecipes.map((recipe) => (
      <div
        class="recipe-wrapper"
        data-recipe-id={recipe.id}
        data-recipe-title={recipe.title.toLowerCase()}
        data-recipe-tags={JSON.stringify(recipe.tags)}
      >
        <Recipe
          title={recipe.title}
          image={recipe.image}
          source={recipe.source}
          tags={recipe.tags}
          notes={recipe.notes}
          type={recipe.type}
          slug={recipe.slug ?? undefined}
        />
      </div>
    ))
  }
</div>

<p class="no-recipes" id="no-recipes" hidden>
  No recipes match that search and filter combination.
</p>

<ScrollToTop />

<script>
  import "../scripts/recipes-filter.ts"
</script>
