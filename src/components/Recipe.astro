---
import Chip from "./Chip.astro"
import { Picture } from "astro:assets"
import { Icon } from "astro-icon/components"
import "./recipe.scss"

interface Props {
  image?: any
  source?: string
  tags?: string[]
  title: string
  tagFilters: string[]
  notes?: string
  type?: string
  slug?: string
}

const {
  image,
  source,
  tags = [],
  title,
  tagFilters = [],
  notes,
  type,
  slug,
} = Astro.props

const destination = type === "custom-recipe" ? slug : source
const isExternal = type !== "custom-recipe"
const tagFiltersSet = new Set(tagFilters)
---

<article class="recipe">
  {
    image && destination && (
      <a
        href={destination}
        target={isExternal ? "_blank" : undefined}
        rel={isExternal ? "nofollow noopener noreferrer" : undefined}
        class="recipe__image-link"
        aria-label={`Open ${title}${isExternal ? " in a new tab" : ""}`}
      >
        <Picture
          src={image}
          alt={title}
          class="recipe__image"
          widths={[300, 450, 600, 800]}
          sizes="(max-width: 700px) 100vw, (max-width: 1088px) 50vw, 33vw"
          formats={["avif", "webp"]}
          quality={70}
          loading="lazy"
        />
      </a>
    )
  }
  <h2 class="recipe__title">
    {
      destination ? (
        <a
          href={destination}
          target={isExternal ? "_blank" : undefined}
          rel={isExternal ? "nofollow noopener noreferrer" : undefined}
        >
          {title}
          {
            isExternal && (
              <Icon
                name="fa6-solid:arrow-up-right-from-square"
                class="recipe__external-icon"
                aria-hidden="true"
              />
            )
          }
          {isExternal && <span class="visually-hidden"> (opens in a new tab)</span>}
        </a>
      ) : (
        title
      )
    }
  </h2>
  {
    tags.length > 0 && (
      <div class="recipe__tags" aria-label={`Tags for ${title}`}>
        {tags.map((tag) => (
          <Chip label={tag} data-tag={tag} active={tagFiltersSet.has(tag)} />
        ))}
      </div>
    )
  }
  {
    notes && notes.trim() !== "" && (
      <details class="recipe__notes">
        <summary>
          <Icon name="fa6-regular:note-sticky" aria-hidden="true" />
          Personal note
        </summary>
        <p>{notes}</p>
      </details>
    )
  }
</article>
